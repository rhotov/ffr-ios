<!-- Switch shader → SPIR-V translation tool. It references the Ryujinx shader translator source kept in the repository (dm/third_party/ryujinx); -p:RyuSrc=<dir> points it at another copy. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RyuSrc Condition="'$(RyuSrc)' == ''">$(MSBuildThisFileDirectory)../../../third_party/ryujinx</RyuSrc>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="ShaderCore/ShaderCore.csproj" />
    <Reference Include="Ryujinx.Common"><HintPath>../dmsh_xlate_bin/Ryujinx.Common.dll</HintPath></Reference>
    <Compile Remove="ShaderCore/**/*.cs;tests/**/*.cs" />
  </ItemGroup>
  <!-- Embeds its own source: the source-sha argument prints its hash, by which dmsh_chain.py checks that the translator was built from the in-repo source -->
  <ItemGroup>
    <EmbeddedResource Include="Program.cs" LogicalName="src0" />
    <EmbeddedResource Include="dmsh_xlate.csproj" LogicalName="src1" />
  </ItemGroup>
</Project>
